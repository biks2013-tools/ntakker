{
  "name": "dual-transcript-merger",
  "version": "0.1.0",
  "description": "Merge macrec dual-channel JSONL sidecars (Apple on-device + Apple Cloud) into a single chronologically-ordered transcript with cross-language hallucination filtering.",
  "type": "module",
  "bin": {
    "dual-transcript-merger": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js",
    "test": "node --test --import tsx test/*.test.ts",
    "clean": "rm -rf dist",
    "prepare": "tsc -p tsconfig.json && chmod +x dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

# ─── Claude Code project-local artifacts ──────────────────────────────────────
# Keep .claude/memory/ committed (per-project Claude memory, intentional in-repo layout)
# Keep .claude/agents/, .claude/commands/, .claude/skills/ if present
# Ignore only the local-only settings and transient state
.claude/settings.local.json
.claude/cache/
.claude/tmp/
.claude/plans/*.draft.md
.claude/.session/
.claude-cache/

# ─── Worktrees & temp scaffolding ─────────────────────────────────────────────
.worktrees/
.claude-worktrees/
tmp/
temp/
scratch/

# ─── Local dev tooling state ──────────────────────────────────────────────────
.docker/
docker-compose.override.yml
.devcontainer/devcontainer.local.json
